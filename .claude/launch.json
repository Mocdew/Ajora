{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ajora-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "dev"],
      "port": 3000
    },
    {
      "name": "ajora-api",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": ["-m", "uvicorn", "api.main:app", "--reload"],
      "port": 8000
    }
  ]
}
