# The frontend proxies browser requests to this API origin at build time.
AJORA_API_BASE=http://localhost:8000

# Set false in a build for the public demo. The API separately enforces whether
# manual circle creation is available.
NEXT_PUBLIC_AJORA_MANUAL_SAVINGS_ENABLED=true

# Optional: the same Web application client ID as the API's AJORA_GOOGLE_CLIENT_ID.
# Set before starting the dev server or building; no client secret is needed.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
