{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ajora-production-web",
  "main": "./worker/production.ts",
  "compatibility_date": "2026-11-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "secrets": { "required": ["AJORA_PRODUCTION_RELAY_TOKEN"] },
  "services": [{ "binding": "AJORA_API", "service": "ajora-production-api" }],
  "assets": {
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": ["/api/engine", "/api/engine/*"]
  },
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": false },
    "traces": { "enabled": false }
  }
}
