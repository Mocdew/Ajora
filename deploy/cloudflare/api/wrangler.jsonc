{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ajora-staging-api",
  "main": "worker.js",
  "compatibility_date": "2026-11-14",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "secrets": {
    "required": [
      "AJORA_AUTH_ORIGINS",
      "AJORA_STAGING_ACCESS_TOKEN",
      "TURSO_DATABASE_URL",
      "TURSO_AUTH_TOKEN"
    ]
  },
  "containers": [
    {
      "class_name": "AjoraApiContainer",
      "image": "../../../Dockerfile.api",
      "image_build_context": "../../..",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "API_CONTAINER", "class_name": "AjoraApiContainer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AjoraApiContainer"] }]
}
