# Ajora API — FastAPI + the pure engine (dedup, communal, explainer).
# Stateless, no database; the labelled persona dataset is seeded into the image.
# Build context is the REPO ROOT (the image needs engine/, api/, and backend/data/).
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Dependencies first for layer caching. scipy/numpy/scikit-learn/pandas install from
# manylinux wheels, so no compiler toolchain is needed on slim.
COPY backend/requirements.txt ./backend/requirements.txt
RUN pip install --no-cache-dir -r backend/requirements.txt

# Application code + the seeded mock dataset (backend/data/mock/*.json).
COPY engine/ ./engine/
COPY api/ ./api/
COPY backend/ ./backend/

EXPOSE 8000

# No --reload in the container; bind all interfaces so the compose network can reach it.
CMD ["python", "-m", "uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
