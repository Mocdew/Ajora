# Ajora API — FastAPI + the pure engine (dedup, communal, explainer).
# Savings uses a local SQLite file; bank insights stay stateless.
# Build context is the REPO ROOT (the image needs engine/, api/, and data/).
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Dependencies first for layer caching. scipy/numpy/scikit-learn install from
# manylinux wheels, so no compiler toolchain is needed on slim.
COPY requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Application code + the seeded mock dataset (data/mock/*.json).
COPY engine/ ./engine/
COPY api/ ./api/
COPY data/ ./data/

EXPOSE 8000

# No --reload in the container; bind all interfaces so the compose network can reach it.
CMD ["python", "-m", "uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
